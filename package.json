{
  "name": "rahulballal-resume",
  "version": "1.0.0",
  "description": "Rahul Ballal's professional resume website",
  "type": "module",
  "scripts": {
    "dev": "astro dev --open",
    "start": "astro dev",
    "build": "astro build && pnpm run validate",
    "build:gh-pages": "astro build",
    "preview": "astro preview",
    "serve:dist": "astro preview",
    "clean": "rm -rf dist",
    "validate": "html-validate 'dist/**/*.html'",
    "test": "node --test",
    "deploy-preview": "pnpm run build && pnpm run preview"
  },
  "keywords": [
    "resume",
    "portfolio",
    "engineering-leadership",
    "rahul-ballal"
  ],
  "author": "Rahul Ballal <rahulballal@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "devDependencies": {
    "ejs": "^5.0.1",
    "html-validate": "^8.7.4",
    "htmlhint": "^1.1.4",
    "http-server": "^14.1.1",
    "marked": "^12.0.2",
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "astro": "^6.3.8",
    "rehype-mermaid": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulballal/rahulballal.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/rahulballal/rahulballal.github.io/issues"
  },
  "homepage": "https://rahulballal.github.io"
}
