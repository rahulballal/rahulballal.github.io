---
import Layout from '../layouts/base.astro';
import { parseResume } from '../lib/parse-resume';
import fs from 'node:fs';
import path from 'node:path';

const resumePath = path.resolve('raw/resume.md');
const markdown = fs.readFileSync(resumePath, 'utf-8');
const data = parseResume(markdown);
---

<Layout
  title={data.name}
  description="Choose between Rahul Ballal's about page and blog."
  canonicalUrl="https://rahulballal.github.io/"
>
  <section class="landing">
    <div class="hero">
      <div class="hero-photo"><img src="/profile-photo.jpeg" alt={data.name} /></div>
      <h1>{data.name}</h1>
      <h2>{data.title}</h2>
      <p class="landing-intro">Choose where you'd like to go next.</p>
    </div>

    <nav class="landing-grid" aria-label="Primary navigation">
      <a class="landing-card" href="/about">
        <span class="landing-card-kicker">About</span>
        <h3>Resume and background</h3>
        <p>Professional experience, skills, and career history.</p>
      </a>

      <a class="landing-card" href="/blog">
        <span class="landing-card-kicker">Blog</span>
        <h3>Writing and ideas</h3>
        <p>Notes on engineering leadership, architecture, and software.</p>
      </a>
    </nav>
  </section>
</Layout>
